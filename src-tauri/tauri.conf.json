{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toram Online Auto Build Calculator",
  "version": "0.5.0",
  "identifier": "com.toramonline.autobuildcalculator",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "토람 온라인 자동 빌드 계산기",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "토람 온라인 대미지 계산기 및 빌드 시뮬레이터",
    "longDescription": "토람 온라인의 스테이터스, 장비, 스킬, 버프와 콤보를 계산하고 세팅을 저장하는 데스크톱 계산기입니다.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
