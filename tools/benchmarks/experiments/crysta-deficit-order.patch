+        // Otherwise already-pruned CRIT failures can dominate the order.
+        if !problem.trees.joint_utilities_possible(&clusters) {
+            continue;
+        }
+        let values = utility_values(
+            &problem.base_context,
+            &selection_evaluation_stats(problem, &selected),
+        )?;
+        let deficit: [f64; 4] = std::array::from_fn(|i| {
+            minima[i].map_or(0.0, |goal| {
+                ((goal - values[i]).max(0.0) / goal.abs().max(1.0)).min(1.0)
+            })
+        });
+        let block_deficits = [deficit[0], deficit[1].max(deficit[2]), deficit[3]];
+        for i in 0..3 {
+            failures[i] += u32::from(block_deficits[i] > 0.0);
+            deficits[i] += block_deficits[i];
+        }
+    }
+    let mut best = 0;
+    for i in 1..3 {
+        if failures[i] > failures[best]
+            || (failures[i] == failures[best] && deficits[i] > deficits[best])
+        {
+            best = i;
+        }
+    }
+    let mut first_direction = 0;
+    for i in 1..5 {
+        if joint_failures[i] > joint_failures[first_direction] {
+            first_direction = i;
+        }
+    }
+    Ok((
+        [UtilityOrder::Hp, UtilityOrder::MpAmpr, UtilityOrder::Crit][best],
+        first_direction,
+    ))
