+/// Sample only actual four-equipment selections from this input. Relative
+/// deficits compare different utility units; they schedule checks, never prune.
+/// The immutable order is rebuilt from raw input on checkpoint restoration.
+fn sampled_probe_order(problem: &NativeProblem) -> Result<(UtilityOrder, usize), String> {
+    let requirements = Requirements::new(
+        problem
+            .scenario_snapshot
+            .get("requirements")
+            .unwrap_or(&Value::Null),
+    );
+    let minima = [
+        requirements.max_hp,
+        requirements.max_mp,
+        requirements.ampr,
+        requirements.crit,
+    ];
+    if minima.iter().all(Option::is_none) || problem.groups.iter().all(|g| g.packages.len() == 1) {
+        return Ok((UtilityOrder::Hp, 0));
+    }
+    let sorted: [Vec<usize>; GROUP_COUNT] = std::array::from_fn(|g| {
+        let mut ids: Vec<_> = (0..problem.groups[g].packages.len()).collect();
+        ids.sort_by(|a, b| {
+            problem.groups[g].packages[*a]
+                .id
+                .cmp(&problem.groups[g].packages[*b].id)
+        });
+        ids
+    });
+    let mut samples = initial_selections(problem);
+    for sample in 0..DEFICIT_SAMPLE_COUNT {
+        samples.push(std::array::from_fn(|g| {
+            let rank = (sample * [1, 5, 11, 17][g] + g * 7) % DEFICIT_SAMPLE_COUNT;
+            sorted[g][rank * sorted[g].len() / DEFICIT_SAMPLE_COUNT]
+        }));
+    }
+    fn leaf_ids(trees: &TreeArena, node: NodeId, ids: &mut [NodeId]) {
+        let n = &trees[node];
+        if let Some(package) = n.package {
+            ids[package] = node;
+        }
+        if let Some(left) = n.left {
+            leaf_ids(trees, left, ids);
+        }
+        if let Some(right) = n.right {
+            leaf_ids(trees, right, ids);
+        }
+    }
+    let leaves: [Vec<NodeId>; GROUP_COUNT] = std::array::from_fn(|g| {
+        let mut ids = vec![NodeId::default(); problem.groups[g].packages.len()];
+        leaf_ids(&problem.trees, problem.trees.roots[g], &mut ids);
+        ids
+    });
+    let mut seen = HashSet::new();
+    let mut failures = [0_u32; 3];
+    let mut joint_failures = [0_u32; 5];
+    let mut deficits = [0.0_f64; 3];
+    for selected in samples {
+        if !seen.insert(selected) {
+            continue;
+        }
+        let clusters = std::array::from_fn(|g| leaves[g][selected[g]]);
+        if let Some(joint) = &problem.trees.joint {
+            let p = clusters.iter().map(|id| joint.crit_p[id.0 as usize]).sum();
+            let required = &joint.minima[joint.bucket_index(p)];
