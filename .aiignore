# Repository AI search profile (gitignore syntax).
# Not a universal AI access control. Apply explicitly: rg --ignore-file .aiignore
# Keep source code, source evidence, tests and fixtures searchable.
.git/
node_modules/
/build/
desktop/target/
engine/target/
desktop/gen/schemas/
coverage/
.cache/
*.log
*.tsbuildinfo
/server/.env
/server/data/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.woff
*.woff2
*.ttf
*.exe
*.dll
*.pdb
*.zip
*.7z
